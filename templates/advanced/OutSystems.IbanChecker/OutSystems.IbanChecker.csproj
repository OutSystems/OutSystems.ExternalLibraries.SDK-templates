<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
        <Nullable>enable</Nullable>
        <!-- Calling an API listed in BannedSymbols.txt fails the build. -->
        <WarningsAsErrors>$(WarningsAsErrors);RS0030</WarningsAsErrors>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="IbanNet" Version="5.8.1" />
        <PackageReference Include="OutSystems.ExternalLibraries.SDK" Version="1.7.0" />
        <PackageReference Include="OutSystems.ExternalLibraries.SDK.FileStorage" Version="1.2.1" />
        <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.0" />
        <!-- Build-time only: checks this project's code and is not part of the uploaded library. -->
        <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="3.3.4" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <!-- FileStorage.Configure and FileStorage.Reset are for the ODC runtime and test projects only. -->
        <AdditionalFiles Include="BannedSymbols.txt" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="resources/format.png" />
        <EmbeddedResource Include="resources/iban_checker.png" />
        <EmbeddedResource Include="resources/validate.png" />
        <EmbeddedResource Include="resources/parse.png" />
        <EmbeddedResource Include="resources/try_parse.png" />
        <EmbeddedResource Include="resources/bulk_validate.png" />
        <EmbeddedResource Include="resources/get_file_metadata.png" />
    </ItemGroup>

</Project>
